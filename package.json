{
  "name": "eve-agent",
  "version": "0.0.0",
  "type": "module",
  "main": "electron-dist/main.js",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build && eve build",
    "dev": "next dev",
    "start": "tsx scripts/prod-start.ts",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n next,electron -c blue,green \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:dist": "npm run build && npm run electron:compile && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "run:chromadb": "python3 -c \"import chromadb_rust_bindings; chromadb_rust_bindings.cli(['chroma','run','--path','./rag/data/chroma_data','--port','8000'])\"",
    "build:index": "TRANSFORMERS_OFFLINE=1 NODE_TLS_REJECT_UNAUTHORIZED=0 tsx rag/scripts/build_index.ts",
    "ask": "tsx --env-file=.env rag/scripts/ask.ts",
    "gen:connections": "npx tsx scripts/gen-connections.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^4.0.14",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.2.2",
    "@zvec/zvec": "^0.5.0",
    "ai": "7.0.0-beta.178",
    "chromadb": "^3.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.18.2",
    "lucide-react": "1.16.0",
    "microsandbox": "^0.5.7",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "ai": "7.0.0-beta.178"
  },
  "resolutions": {
    "ai": "7.0.0-beta.178"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@zvec/zvec@0.5.0": true,
    "esbuild@0.28.1": true,
    "electron": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
